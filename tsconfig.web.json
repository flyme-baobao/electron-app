{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "jsx": "preserve",
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "isolatedModules": true,
        "paths": {
            "@/*": ["./src/renderer/*"]
        }
    },
    "include": [
        "src/renderer/**/*.ts",
        "src/renderer/**/*.vue",
        "src/preload/**/*.d.ts"
    ]
}